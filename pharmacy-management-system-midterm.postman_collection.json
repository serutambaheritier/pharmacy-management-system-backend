    {
      "name": "Find unused drug classes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/drug-classes/unused",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "drug-classes",
            "unused"
          ]
        }
      }
    },
    {
      "name": "Find customers of pharmacist",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/customers/of-pharmacist/{{pharmacistId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "customers",
            "of-pharmacist",
            "{{pharmacistId}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
