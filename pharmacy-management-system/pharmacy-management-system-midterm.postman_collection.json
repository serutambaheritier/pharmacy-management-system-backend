{
  "info": {
    "name": "Pharmacy Management System Midterm",
    "description": "Postman requests for the Pharmacy Management System midterm. Requirements are grouped by Part and requests are named by requirement ID. Run A2 to create a drug order, then use GET list requests to copy generated IDs into collection variables. Change orderDate to today or a future date before creating orders.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Pharmacy Management System Tests",
      "description": "Requirement tests and CRUD requests. Update collection variables with IDs from your database before sending requests that use them.",
      "item": [
        {
          "name": "Part A - Core operations",
          "description": "A2: create a drug order. CRUD requests for other entities are in the CRUD folder.",
          "item": [
            {
              "name": "A2 - Save drug order",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"orderDate\": \"{{orderDate}}\",\n  \"status\": \"PLACED\",\n  \"prescriptionRef\": \"TEST-ORDER-001\",\n  \"totalAmount\": 25.00,\n  \"customer\": { \"id\": \"{{customerId}}\" },\n  \"pharmacist\": { \"id\": \"{{pharmacistId}}\" }\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/drug-orders/save",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "drug-orders",
                    "save"
                  ]
                }
              }
            }
          ]
        },
